# Salin ke .env lalu isi. JANGAN commit .env (sudah di .gitignore).
KENARI_API_KEY=kn-isi-dari-dashboard-kenari
# Wajib jika HOST=0.0.0.0 (mis. di VPS). Token untuk Claude (MCP) dan klien API.
ACCESS_TOKEN=
# Login web dashboard. Wajib jika HOST=0.0.0.0 (password minimal 8 karakter).
# Ganti kapan saja lalu restart container: semua sesi login lama otomatis tidak berlaku.
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_HOURS=168
HOST=127.0.0.1
PORT=3400
DEFAULT_MODEL=gpt-image-2
# Batas biaya (aturan kantor: pengeluaran butuh persetujuan Owner)
# Nilai awal. Setelah itu bisa diubah di web: Dashboard > Batas Biaya. 0 = tanpa batas.
DAILY_BUDGET_IDR=5000
WEEKLY_BUDGET_IDR=0
MONTHLY_BUDGET_IDR=0
APPROVAL_THRESHOLD_IDR=1000
MAX_N=5
# URL publik bila di-deploy (untuk tautan di respons MCP)
PUBLIC_URL=
# Gambar sementara: dihapus permanen setelah sekian hari (kebijakan Owner: 7)
RETENTION_DAYS=7
# Opsional: rahasia penanda-tangan tautan publik (default: ACCESS_TOKEN)
SIGNING_SECRET=
