{
  "name": "delova-studio",
  "version": "0.1.0",
  "description": "Delova Studio: web app + MCP server untuk generate gambar via API kenari.id",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "mcp:stdio": "node --disable-warning=ExperimentalWarning src/stdio.js",
    "test": "node --test --test-force-exit",
    "build:css": "tailwindcss -c tailwind.config.cjs -i assets/input.css -o public/tailwind.css --minify"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
